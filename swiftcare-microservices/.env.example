# Copy this file to .env. Never commit the resulting .env file.

DB_URL=jdbc:postgresql://localhost:5432/swiftcare
DB_USERNAME=swiftcare
DB_PASSWORD=replace-with-a-strong-database-password

# Use one identical, randomly generated secret (at least 32 bytes) in every service.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRY_MS=86400000

# Use a different random secret for trusted service-to-service requests.
INTERNAL_SERVICE_KEY=replace-with-a-separate-random-internal-service-key

AI_API_KEY=
AI_MODEL=gemini-2.0-flash-lite

FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
EXPO_PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=swiftcare://subscription/callback
PAYSTACK_MONTHLY_PRICE_PESEWAS=5000
PAYSTACK_YEARLY_PRICE_PESEWAS=50000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SENDER_NAME=SwiftCare
PASSWORD_RESET_EXPIRY_MINUTES=15
PASSWORD_RESET_URL=swiftcare://reset-password

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=SwiftCare Administrator

CORS_ALLOWED_ORIGIN_PATTERN=*
IDENTITY_SERVICE_URL=http://localhost:8081
APPOINTMENT_SERVICE_URL=http://localhost:8082
CLINICAL_SERVICE_URL=http://localhost:8083
SYMPTOM_SERVICE_URL=http://localhost:8084
SUBSCRIPTION_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
